{
  "name": "wikimasters",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wikimasters", "database_id": "6ac810b7-6df0-4e97-8f67-b2f3a12588ed" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  // Tâche planifiée toutes les 5 minutes (économise les lectures D1 gratuites) : remplit la réserve de cartes prêtes et anime le marché (joueurs simulés)
  "triggers": { "crons": ["*/5 * * * *"] },
  // Le Worker s'exécute près de la base D1 : beaucoup moins de latence pour les requêtes qui enchaînent plusieurs lectures
  "placement": { "mode": "smart" },
  // Workers AI (plan gratuit : 10 000 neurons/jour) : écrit les questions de la bataille à partir de l'article. AI_QUIZ="0" dans "vars" pour le couper.
  "ai": { "binding": "AI" }
  // Pour exiger un code d'invitation à l'inscription : "vars": { "INVITE_CODE": "ton-code" }
}
