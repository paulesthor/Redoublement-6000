# Mise en cache : polices et icônes ne changent pas ; scripts et styles sont toujours revalidés (réponse 304 quasi instantanée si inchangés) pour que les mises à jour arrivent tout de suite.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/app.js
  Cache-Control: no-cache
/reveal.js
  Cache-Control: no-cache
/pack.js
  Cache-Control: no-cache
/qrcode.js
  Cache-Control: no-cache
/jsQR.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/style.css
  Cache-Control: no-cache
/fonts.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sw.js
  Cache-Control: no-cache
