# Copy this file to .env for local development (never commit the real .env)

# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Spotify Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Random long string used to sign the session cookie
SESSION_SECRET=change-me-to-a-random-string

# Public base URL of the deployed app (used to build the Spotify redirect URI in production)
APP_BASE_URL=http://127.0.0.1:8000
