{
  // Configuration Cloudflare lue quand le déploiement automatique (Workers Builds) s'exécute à la racine du dépôt.
  // Elle déploie le projet du dossier cloudflare/ ; ce dossier a sa propre configuration identique pour un déploiement à la main.
  "name": "wikimasters",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wikimasters", "database_id": "6ac810b7-6df0-4e97-8f67-b2f3a12588ed" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  // Tâche planifiée chaque minute : remplit la réserve de cartes prêtes et anime le marché (joueurs simulés)
  "triggers": { "crons": ["* * * * *"] },
  // Le Worker s'exécute près de la base D1 : beaucoup moins de latence pour les requêtes qui enchaînent plusieurs lectures
  "placement": { "mode": "smart" },
  // Workers AI (plan gratuit : 10 000 neurons/jour) : écrit les questions de la bataille à partir de l'article. AI_QUIZ="0" dans "vars" pour le couper.
  "ai": { "binding": "AI" }
}
